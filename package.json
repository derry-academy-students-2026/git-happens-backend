		"@types/express": "^5.0.6",
		"@types/morgan": "^1.9.10",
		"@types/node": "^26.1.2",
		"@types/supertest": "^7.2.1",
		"@vitest/coverage-v8": "^4.1.10",
		"morgan": "^1.10.0",
		"supertest": "^7.2.2",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2",
