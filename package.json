{
	"name": "web-starter",
	"version": "1.0.0",
	"description": "dev",
	"main": "index.js",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc",
		"start": "node dist/index.js",
		"test": "vitest run",
