{
	"name": "web-starter",
	"version": "1.0.0",
	"description": "dev",
	"main": "index.js",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"predev": "npm run db:sync",
		"build": "tsc",
		"start": "node dist/index.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check .",
		"ci:check": "biome ci .",
		"lint:fix": "biome lint --write .",
		"postinstall": "npx prisma generate",
		"env:setup": "[ -f .env ] || echo 'DATABASE_URL=\"postgresql://postgres:password@localhost:5432/job-board\"' > .env",
		"db:migrate": "npx prisma migrate dev",
		"db:sync": "npm run env:setup && npx prisma generate && npx prisma migrate deploy",
		"db:reset": "npx prisma migrate reset --force; npm run prisma:seed",
		"db:setup": "npm run env:setup && npm run db:sync && npm run prisma:seed",
		"prisma:seed": "tsx prisma/seed.ts",
		"ci": "echo 'CI check not implemented yet'"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@prisma/client": "^6.15.0",
		"express": "^5.2.1",
		"winston": "^3.19.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@types/express": "^5.0.6",
		"@types/morgan": "^1.9.10",
		"@types/node": "^26.1.2",
		"@types/supertest": "^7.2.1",
		"@vitest/coverage-v8": "^4.1.10",
		"morgan": "^1.10.0",
		"prisma": "^6.15.0",
		"supertest": "^7.2.2",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
