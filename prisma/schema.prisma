// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model JobRole {
  jobRoleId          Int      @id @default(autoincrement())
  roleName           String
  location           String
  capabilityId       String
  bandId             Decimal  @db.Decimal(10, 2)
  closingDate        DateTime @default(now())
  status             DateTime @updatedAt
}

model Capability {
  capabilityId          Int      @id @default(autoincrement())
  capabilityName        String
}

model Band {
  nameId          Int      @id @default(autoincrement())
  bandName        String
}